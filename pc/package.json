{
  "name": "flashlight-pc",
  "version": "1.0.0",
  "private": true,
  "description": "손전등 PC 버전",
  "author": "our-diary",
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ourdiary.pc",
    "productName": "Flashlight",
    "files": ["main.js", "www/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "icon": "www/icons/icon-512.png" },
    "portable": { "artifactName": "our-diary.exe" }
  }
}
